{
  "about": "BYE design tokens: the single source for the website, the web app, the Windows app and the Mac app. Edit this file, then run `pnpm build:tokens`. Light mode only.",
  "color": {
    "paper": { "value": "#faf8f3", "note": "ivory page" },
    "linen": { "value": "#f2eee6", "note": "panels, sidebars" },
    "card": { "value": "#ffffff" },
    "tile": { "value": "#eae5db", "note": "stone cards, bar tracks" },
    "tileLine": { "value": "#ddd6c9" },
    "ink": { "value": "#161618", "note": "Jet Black: text, primary buttons, sticker outlines" },
    "ink2": { "value": "#5f5a52", "note": "body text, 6.6:1 on paper" },
    "ink3": { "value": "#6b665e", "note": "fine print, 5.4:1 on paper" },
    "line": { "value": "#e2dcd0" },
    "lineStrong": { "value": "#8c857a" },
    "accent": { "value": "#f2c14e", "note": "yellow: swipe, one headline phrase, rating bars, progress, and playful accents (confetti, avatar initials, primary button offset shadow). Never large surfaces, body text or backgrounds." },
    "brandSoft": { "value": "#efe9dd", "note": "tag background" },
    "signal": { "value": "#b8401a", "note": "warnings and errors only" }
  },
  "font": {
    "display": { "css": "\"Libre Baskerville\", Baskerville, Georgia, serif", "weights": [600, 700], "note": "headings and big numbers" },
    "sans": { "css": "\"Schibsted Grotesk\", system-ui, -apple-system, sans-serif", "weights": [400, 600, 700], "note": "text on web and Windows; the Mac uses SF Pro" },
    "mono": { "css": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, monospace", "weights": [500], "note": "course codes only" }
  },
  "size": {
    "hero": 48,
    "title": 32,
    "heading": 24,
    "subheading": 20,
    "body": 16,
    "label": 14,
    "small": 13,
    "caption": 11
  },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 },
  "radius": { "sm": 6, "md": 10, "lg": 16, "card": 18, "window": 22, "pill": 999 },
  "border": { "sticker": 1.5, "control": 1.5, "hairline": 1 },
  "shadow": {
    "float": [{ "y": 1, "color": "ink", "alpha": 0.05 }, { "y": 24, "blur": 48, "spread": -28, "color": "ink", "alpha": 0.38 }],
    "soft": [{ "y": 1, "color": "ink", "alpha": 0.04 }, { "y": 12, "blur": 28, "spread": -20, "color": "ink", "alpha": 0.3 }],
    "sticker": [{ "x": 2, "y": 2, "color": "ink", "alpha": 1 }],
    "stickerLarge": [{ "x": 4, "y": 4, "color": "ink", "alpha": 1 }],
    "accentOffset": [{ "x": 3, "y": 3, "color": "accent", "alpha": 1 }]
  },
  "tilt": { "note": 0.6, "sticker": 4, "idCard": 4 },
  "motion": {
    "easing": {
      "expo": [0.16, 1, 0.3, 1],
      "spring": [0.34, 1.56, 0.64, 1]
    },
    "spring": { "response": 0.45, "dampingFraction": 0.7 },
    "durationMs": {
      "fast": 150,
      "slide": 450,
      "screen": 550,
      "swipe": 900,
      "bars": 1000,
      "countUp": 800,
      "stagger": 70,
      "confetti": 1300,
      "typedHintTick": 110
    }
  },
  "breakpoint": { "md": 600, "lg": 900, "xl": 1200 }
}
