    { "by": "oldest", "expected": ["c", "b", "f", "a", "d", "e"] },
    { "by": "highest", "expected": ["a", "c", "e", "b", "f", "d"] },
    { "by": "lowest", "expected": ["b", "f", "e", "a", "c", "d"] },
    { "by": "highestDifficulty", "expected": ["b", "f", "a", "c", "d", "e"] },
