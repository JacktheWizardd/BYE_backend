    { "id": "b", "rating": 3, "difficulty": 4, "date": "2026-05-01" },
    { "id": "c", "rating": 5, "difficulty": 2, "date": "2025-12-01" },
    { "id": "d", "difficulty": 1, "date": "2026-10-01 00:00:00 +0000 UTC" },
    { "id": "e", "rating": 4, "date": "not a date" },
    { "id": "f", "rating": 3, "difficulty": 4, "date": "2026-05-01" }
  ],
  "cases": [
