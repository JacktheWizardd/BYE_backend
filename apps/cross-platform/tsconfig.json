{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true,
    "lib": ["ES2023", "DOM"], "types": ["node"], "noEmit": true
  },
  "include": ["src", "vendor", "tests", "scripts/*.ts", "electron.vite.config.ts"]
}
