{
  "name": "bye-cross-platform",
  "version": "0.5.0",
  "private": true,
  "description": "Before You Enroll — separate cross-platform desktop beta",
  "author": "BYE contributors",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && electron-vite build",
    "model:fetch": "node scripts/fetch-model.mjs",
    "runtime:fetch": "node node_modules/electron/install.js",
    "ai:verify": "tsx scripts/verify-ai.ts",
    "live:verify": "tsx scripts/verify-live.ts",
    "ui:verify": "tsx scripts/verify-ui.ts",
    "packaged:verify": "tsx scripts/verify-packaged.ts",
    "package:win": "npm run build && node scripts/package.mjs",
    "verify:zip": "node scripts/verify-zip.mjs",
    "ui:verify:offline": "npm run build && node scripts/verify-offline.mjs",
    "perf:verify:offline": "npm run build && node scripts/verify-offline.mjs --perf"
  },
  "dependencies": {
    "node-llama-cpp": "3.22.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@electron/asar": "4.0.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.7.0",
    "electron-builder": "26.0.12",
    "electron-vite": "4.0.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=22.16"
  },
  "overrides": {
    "simple-git": "4.0.2",
    "@simple-git/argv-parser": "2.0.1"
  }
}
