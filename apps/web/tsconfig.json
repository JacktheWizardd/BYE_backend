{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node", "vite/client"], "noEmit": true,
    "baseUrl": ".", "paths": { "@shared/*": ["../cross-platform/src/shared/*"] }
  },
  "include": ["src", "tests", "vite.config.ts"]
}
