        "name": "OWNER_SESSIONS",
        "class_name": "OwnerSessions"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OwnerSessions"
      ]
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://bye-admin.jack-truong2k1.workers.dev",
    "SUPABASE_URL": "https://nahvhampsxtasfwvvfei.supabase.co",
