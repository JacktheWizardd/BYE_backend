{
  "name": "bye-admin",
  "main": "./cloudflare.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": true
