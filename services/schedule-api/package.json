{
  "name": "bye-schedule-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.3"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:db": "node tests/database.mjs",
    "benchmark": "deno run --allow-read --allow-env scripts/benchmark.ts",
    "check": "deno check src/api.ts src/sync.ts src/admin.ts dashboard/hosted/session.ts dashboard/hosted/cloudflare.ts",
    "deploy": "node scripts/deploy.mjs",
    "owner": "node scripts/owner.mjs",
    "admin": "node --env-file-if-exists=.env --experimental-strip-types dashboard/server.ts",
    "verify:hosted": "node scripts/verify-hosted.mjs",
    "admin:build": "wrangler deploy --config dashboard/hosted/wrangler.jsonc --dry-run --outdir .deploy/hosted-admin",
    "admin:deploy": "wrangler deploy --config dashboard/hosted/wrangler.jsonc",
    "test:admin:runtime": "npm run admin:build && node tests/hosted-runtime.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "24.10.0",
    "deno": "2.9.6",
    "miniflare": "5.20261019.0-beta",
    "supabase": "2.121.0",
    "wrangler": "4.151.2"
  }
}
